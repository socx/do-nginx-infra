[Unit]
Description=asset-manager frontend service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/apps/asset-manager/frontend
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5174
ExecStart=/usr/bin/npm run start -- --host 127.0.0.1 --port 5174
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
