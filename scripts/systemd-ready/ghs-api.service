[Unit]
Description=ghs api service
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/apps/ghs/apps/api
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3005
Environment=API_PORT=3005
ExecStart=/bin/bash -lc 'source "$HOME/.nvm/nvm.sh" && nvm use node >/dev/null && node src/index.js'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
