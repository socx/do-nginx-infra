[Unit]
Description=asset-manager api service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/apps/asset-manager/api
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3004
ExecStart=/usr/bin/npm run start -- --host 127.0.0.1 --port 3004
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
