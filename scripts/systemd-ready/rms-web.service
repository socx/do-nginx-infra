[Unit]
Description=rms web service
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/apps/rms/web
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5173
ExecStart=/bin/bash -lc 'source "$HOME/.nvm/nvm.sh" && nvm use node >/dev/null && npm run start -- --host 127.0.0.1 --port 5173'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
